# ─────────────────────────────────────────────────────────────────────────────
# QONTINT REPOSITORY — Environment Configuration Quickstart
# ─────────────────────────────────────────────────────────────────────────────
# 1. Backend:  cp backend/.env.example backend/.env
# 2. Frontend: cp frontend/.env.example frontend/.env (optional for local dev)
#
# NEVER commit real .env files containing credentials to Git.
# Both root and submodule .gitignore files protect your private credentials.
# ─────────────────────────────────────────────────────────────────────────────

# Backend environment configuration (backend/.env):
ENVIRONMENT=development
LOG_LEVEL=INFO
API_SECRET_KEY=change_me_in_production_use_32chars
DATABASE_URL=sqlite+aiosqlite:///./data/qontint.db
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=30

# Optional SERP Providers (defaults to free DuckDuckGo / Playwright):
# SERPER_API_KEY=your_serper_api_key_here
# TAVILY_API_KEY=your_tavily_api_key_here

# Frontend environment configuration (frontend/.env):
# VITE_API_BASE_URL=https://your-backend-api-url.com
