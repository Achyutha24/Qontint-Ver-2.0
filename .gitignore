# --- Root .gitignore ---

# Environment Files
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.env
!.env.example
!**/.env.example

# Dependencies
node_modules/
backend/venv/
backend/.venv/
env/
venv/
.venv/
pip-log.txt
pip-delete-this-directory.txt

# Python cache
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.tox/

# Databases & Backups
*.sqlite
*.sqlite3
*.db
*.db-shm
*.db-wal
*.db.bak
*.bak

# Build outputs
dist/
build/
*.egg-info/
.next/
out/

# IDEs and Tools
.vscode/
.idea/
.DS_Store
Thumbs.db
*.swp
*.swo

# Logs
*.log
logs/
backend/logs/

# Project specific
backend/ml_models/
frontend/coverage/
.gemini/
backend/tests/benchmark_history.json
