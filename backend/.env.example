# ─────────────────────────────────────────────────────────────────────────────
# QONTINT BACKEND — Environment Configuration
# ─────────────────────────────────────────────────────────────────────────────
# 1. Copy this file:  cp .env.example .env
# 2. Fill in the values marked with <...>
# 3. NEVER commit .env to git — it is already in .gitignore
# ─────────────────────────────────────────────────────────────────────────────

# Application
ENVIRONMENT=production
LOG_LEVEL=INFO
API_SECRET_KEY=<generate-a-random-32-char-string>
ALLOWED_ORIGINS=["https://<your-frontend-domain>"]

# Database (SQLite — zero dependency)
DATABASE_URL=sqlite+aiosqlite:///./data/qontint.db

# Gemini API (free tier)
# Get your key at: https://aistudio.google.com/
GOOGLE_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT=30

# SERP API Providers (Optional — defaults to free DuckDuckGo / Playwright)
# SERPER_API_KEY=<your-serper-api-key>
# TAVILY_API_KEY=<your-tavily-api-key>

# SERP Scraper (Playwright — free)
SCRAPER_DELAY_MS=0
SCRAPER_MAX_RESULTS=5
SCRAPER_HEADLESS=true

# ML Models
ML_MODELS_DIR=./ml_models
MODEL_RETRAIN_INTERVAL_DAYS=7

# Cache TTLs (seconds)
CACHE_NOVELTY_TTL=3600
CACHE_AUTHORITY_TTL=86400
CACHE_RANKING_TTL=3600

# Rate Limiting
RATE_LIMIT_DEFAULT=60/minute
RATE_LIMIT_SERP=10/minute
RATE_LIMIT_GENERATE=5/minute

# Groq API (Generate Page ONLY — Groq ONLY)
# Free fast API key at: https://console.groq.com/keys
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
GROQ_BASE_URL=https://api.groq.com/openai/v1
GROQ_TIMEOUT=60
